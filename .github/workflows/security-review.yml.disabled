# OPTIONAL, PAID, OFF BY DEFAULT: Anthropic's open-source security review on every PR.
#
# Cost: each PR runs a Claude security analysis billed per token to an Anthropic API key.
# This action takes an API key only (no Claude subscription token option). The local
# /security-review pass (CLAUDE.md, implementation step 3) does the same job for free,
# which is why this is off.
#
# Note from the action's README: it is not hardened against prompt injection, so only use it
# on trusted PRs. For a public repo, require approval for workflows from outside contributors.
#
# To turn it on:
#   1. Add a repo secret CLAUDE_API_KEY (Settings > Secrets and variables > Actions) holding an
#      Anthropic API key enabled for both the Claude API and Claude Code.
#   2. Rename this file to security-review.yml and uncomment everything below.
#
# Checked against anthropics/claude-code-security-review (README, action.yml inputs:
# claude-api-key, comment-pr, upload-results, exclude-directories, claude-model,
# claudecode-timeout, run-every-commit, false-positive-filtering-instructions,
# custom-security-scan-instructions) on 2026-10-19. Re-check before turning it on.
#
# name: Security review
#
# on:
#   pull_request:
#
# permissions:
#   contents: read
#   pull-requests: write
#
# concurrency:
#   group: security-review-${{ github.ref }}
#   cancel-in-progress: true
#
# jobs:
#   security:
#     runs-on: ubuntu-latest
#     steps:
#       - uses: actions/checkout@v4
#         with:
#           ref: ${{ github.event.pull_request.head.sha || github.sha }}
#           fetch-depth: 2
#
#       - uses: anthropics/claude-code-security-review@main
#         with:
#           comment-pr: true
#           claude-api-key: ${{ secrets.CLAUDE_API_KEY }}
#           # exclude-directories: "node_modules,dist,bin,obj"
